{
  "name": "@crong964/angel-table",
  "version": "0.0.3",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "react-table",
    "data-table",
    "typescript",
    "nextjs",
    "table-component"
  ],
  "description": "A flexible and customizable React Table component",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "main": "./dist/angel-table.umd.cjs",
  "module": "./dist/angel-table.js",
  "types": "./dist/lib/main.d.ts",
  "style": "./dist/angel-table.css",
  "exports": {
    ".": {
      "types": "./dist/lib/main.d.ts",
      "import": "./dist/angel-table.js",
      "require": "./dist/angel-table.umd.cjs"
    },
    "./style.css": "./dist/angel-table.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "rm -rf dist",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "publish": "npm publish"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crong964/angel-table.git"
  },
  "homepage": "https://demo-table-seven.vercel.app/",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.90.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2"
  }
}
